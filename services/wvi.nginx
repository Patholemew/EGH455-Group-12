server {
    listen 80 default_server;
    server_name _;

    location /static/ {
        alias /home/egh455-g12/EGH455-Group-12/wvi/static/;
    }

    location = /live.jpg {
        alias /dev/shm/uav/liveimage.jpg;
        add_header Cache-Control "no-store";
    }

    location /snapshots/ {
        alias /var/lib/uav-wvi/snapshots/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}