[Unit]
Description=Camera capture and detection service
After=wvi.service

[Service]
User=egh455-g12
WorkingDirectory=/home/egh455-g12/EGH455-Group-12/aip
ExecStart=/home/egh455-g12/EGH455-Group-12/.venv/bin/python aip_main.py
Environment=WVI_FRAME_FILE=/dev/shm/uav/liveimage.jpg
Environment=WVI_SNAPSHOT_DIR=/var/lib/uav-wvi/snapshots
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target